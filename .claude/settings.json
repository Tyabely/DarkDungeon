{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__unreal-mcp__call_tool",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/unreal-mcp-guard.js\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-direct-mcp.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
